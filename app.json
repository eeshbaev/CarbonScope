{
  "expo": {
    "name": "CarbonScope",
    "slug": "CarbonScope",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#25694F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carbonscope.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "CarbonScope can send local reminders about unfinished assessments and reporting deadlines. You can turn notifications off in Settings."
      }
    },
    "android": {
      "package": "com.carbonscope.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#25694F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2D6A4F"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "d436d4b4-53d7-4030-9bc9-25a9e8d05966"
      }
    }
  }
}
